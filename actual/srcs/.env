# ======================
#   Domain Setup
# ======================
DOMAIN_NAME=shattori.42.fr

# ======================
#   MariaDB Setup
# ======================
MYSQL_DATABASE=wordpress
MYSQL_USER=shattori_user
MYSQL_PASSWORD=strong_db_password
MYSQL_ROOT_PASSWORD=strong_root_password

# ======================
#   WordPress Setup
# ======================
# 注意: 管理者名(ADMIN_USER)に 'admin' や 'administrator' は使用禁止
WP_ADMIN_USER=boss_shattori
WP_ADMIN_PASSWORD=strong_admin_password
WP_ADMIN_EMAIL=boss@shattori.42.fr

WP_USER=normal_shattori
WP_USER_PASSWORD=strong_normal_password
WP_USER_EMAIL=normal@shattori.42.fr